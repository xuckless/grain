{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Workstation",
  "version": "0.1.0",
  "identifier": "dev.workstation.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5174",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "Workstation", "width": 1280, "height": 860 }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png"]
  }
}
